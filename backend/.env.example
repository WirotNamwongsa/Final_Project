# Environment Variables Example (Backend)

# Server Configuration
NODE_ENV=development
PORT=13001
FRONTEND_URL=http://localhost:13000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database Configuration (PostgreSQL via Supabase)
# Format: postgresql://postgres:YOUR_PASSWORD@your-project.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@your-project.supabase.co:5432/postgres
DB_SSL=true

# Legacy Database Configuration (Old college database - not used anymore)
# DATABASE_URL=postgresql://admin_ltc:LTC_%40dmission69@docker3.loeitech.org:56432/ltc_admission_db
# DB_PASSWORD=LTC_@dmission69

# Authentication
# Change these in PRODUCTION environment
JWT_SECRET=your_jwt_secret_change_this_in_production
JWT_EXPIRES_IN=7d

# Slipok API (for payment slip verification)
SLIPOK_API_KEY=your_slipok_api_key
SLIPOK_BRANCH_ID=your_slipok_branch_id

# Gemini API (for OCR)
GEMINI_API_KEY=your_gemini_api_key
